  {
   "parameters": {
    "jsCode": "const b = $json.body || {}, src = $('MP: leer aviso de pago').item.json;\nconst ok = $json.statusCode === 200 && b.status === 'approved' && !!b.external_reference;\nreturn { json: { ok, tenant_id: src.tenant_id, provider: 'mercadopago', event_id: 'mp-pay-' + b.id,\n  order_id: b.external_reference || '', ref: String(b.id || ''), payload: { id: b.id, status: b.status, amount: b.transaction_amount } } };",
    "mode": "runOnceForEachItem"
   },

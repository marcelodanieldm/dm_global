  {
   "parameters": {
    "jsCode": "// Mercado Pago avisa pagos (topic/type payment). Se vuelve a leer el pago con la API: no se confía en el aviso\nconst q = $json.query || {}, b = $json.body || {};\nconst type = b.type || b.topic || q.type || q.topic || '';\nconst id = (b.data && b.data.id) || q['data.id'] || q.id || '';\nreturn { json: { tenant_id: q.tenant || '', type, id: String(id), relevant: type === 'payment' && !!id && !!q.tenant } };",
    "mode": "runOnceForEachItem"
   },

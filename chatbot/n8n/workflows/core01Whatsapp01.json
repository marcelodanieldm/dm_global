  {
   "parameters": {
    "jsCode": "// Convierte el payload de Meta en un ítem por mensaje entrante (ignora estados de entrega)\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || {};\n  for (const entry of body.entry || []) for (const ch of entry.changes || []) {\n    const v = ch.value || {};\n    const pnid = v.metadata && v.metadata.phone_number_id;\n    const names = {};\n    for (const c of v.contacts || []) names[c.wa_id] = c.profile && c.profile.name;\n    for (const m of v.messages || []) {\n      let text = '';\n      if (m.type === 'text') text = (m.text && m.text.body) || '';\n      else if (m.type === 'interactive') text = (m.interactive.button_reply || m.interactive.list_reply || {}).title || '';\n      else if (m.type === 'button') text = (m.button && m.button.text) || '';\n      else text = '[' + m.type + ']';\n      out.push({ json: { phone_number_id: pnid, from: m.from, text, message_id: m.id,\n                         contact_name: names[m.from] || null, channel: 'whatsapp' } });\n    }\n  }\n}\nreturn out;"
   },

  },
  {
   "parameters": {
    "jsCode": "const j = $('Resultado de la pasarela').item.json;\nreturn { json: { phone_number_id: j.phone_number_id, access_token: j.access_token, graph_version: j.graph_version, to: j.to,\n  message: { type: 'interactive', interactive: { type: 'cta_url',\n    body: { text: 'Listo, ' + j.name + '. Este es tu link para pagar ' + j.service + ' (compra #' + j.number + '). Cuando se acredite te aviso por acá.' },\n    action: { name: 'cta_url', parameters: { display_text: 'Pagar ahora', url: j.url } } } } } };",
    "mode": "runOnceForEachItem"
   },
   "id": "58113df3-c432-5be6-8164-1af8c2b07843",
   "name": "Mensaje con link",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1620,
    -80
   ]
  },
  {
   "parameters": {
    "jsCode": "const j = $json;\nreturn { json: { phone_number_id: j.phone_number_id, access_token: j.access_token, graph_version: j.graph_version, to: j.to,\n  message: { type: 'text', text: 'Perdón, no pude generar el link de pago en este momento. Un asesor te va a escribir para completar el alta.' },\n  error: j.error } };",
    "mode": "runOnceForEachItem"
   },

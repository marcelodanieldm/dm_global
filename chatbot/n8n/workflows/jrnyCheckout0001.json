   "position": [
    440,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.mercadopago.com/checkout/preferences",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $json.c.provider_token }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({\n  items: [{ title: $json.c.service.name, quantity: 1, unit_price: Number($json.c.service.price), currency_id: $json.c.service.currency }],\n  external_reference: $json.c.order_id,\n  payer: { email: $json.c.customer.email, name: $json.c.customer.name },\n  notification_url: $json.c.notification_url,\n  back_urls: { success: $json.c.provider_config.success_url || 'https://dmglobal.tech', failure: $json.c.provider_config.back_url || 'https://dmglobal.tech',\n               pending: $json.c.provider_config.back_url || 'https://dmglobal.tech' },\n  statement_descriptor: String($json.c.tenant_name).slice(0, 22)\n}) }}",
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     },
     "timeout": 20000
    }
   },
   "id": "bd8a3059-6126-5371-ab04-adc27fc75ec8",
   "name": "Mercado Pago: crear preferencia",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    700,
    -180
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.stripe.com/v1/checkout/sessions",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $json.c.provider_token }}"
      }
     ]
    },
    "sendBody": true,
    "contentType": "form-urlencoded",
    "bodyParameters": {
     "parameters": [
      {
       "name": "mode",
       "value": "payment"
      },
      {
       "name": "line_items[0][price_data][currency]",
       "value": "={{ String($json.c.service.currency).toLowerCase() }}"
      },
      {
       "name": "line_items[0][price_data][product_data][name]",
       "value": "={{ $json.c.service.name }}"
      },
      {
       "name": "line_items[0][price_data][unit_amount]",
       "value": "={{ Math.round(Number($json.c.service.price) * 100) }}"
      },
      {
       "name": "line_items[0][quantity]",
       "value": "1"
      },
      {
       "name": "client_reference_id",
       "value": "={{ $json.c.order_id }}"
      },
      {
       "name": "customer_email",
       "value": "={{ $json.c.customer.email }}"
      },
      {
       "name": "metadata[tenant_id]",
       "value": "={{ $json.c.tenant_id }}"
      },
      {
       "name": "metadata[service_order_id]",
       "value": "={{ $json.c.order_id }}"
      },
      {
       "name": "success_url",
       "value": "={{ $json.c.provider_config.success_url || 'https://dmglobal.tech' }}"
      },
      {
       "name": "cancel_url",
       "value": "={{ $json.c.provider_config.back_url || 'https://dmglobal.tech' }}"
      }
     ]
    },
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     },
     "timeout": 20000
    }
   },
   "id": "efeb96ef-46ed-5bbf-ac7f-732572ccfd31",
   "name": "Stripe: crear checkout de pago",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    700,
    -40
   ]
  },
  {
   "parameters": {
    "jsCode": "const c = $json.c;\nreturn { json: { url: c.mock_url, ref: 'mock-' + c.order_id } };",
    "mode": "runOnceForEachItem"
   },
   "id": "0ff25895-0dca-5009-9e31-51d68ae66884",
   "name": "Simulada: armar link",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    700,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "return { json: { error: 'El cliente no tiene pasarela de pago configurada (payment_integrations)' } };",
    "mode": "runOnceForEachItem"
   },
   "id": "80855c2a-cb43-573e-b7e1-a8d5f8a128e3",
   "name": "Sin pasarela",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    700,
    240
   ]
  },
  {
   "parameters": {
    "jsCode": "// Normaliza la respuesta de la pasarela: {url, ref} o {error}\nconst c = $('Datos de la compra').item.json.c;\nconst j = $json; let url = null, ref = null, error = j.error || null;\nif (!error && j.statusCode !== undefined) {\n  const b = j.body || {};\n  if (j.statusCode >= 200 && j.statusCode < 300) { url = b.init_point || b.url; ref = b.id; }\n  else error = 'HTTP ' + j.statusCode + ': ' + JSON.stringify(b.message || b.error || b).slice(0, 300);\n} else if (!error) { url = j.url; ref = j.ref; }\nif (!url && !error) error = 'La pasarela no devolvió un link de pago';\nreturn { json: { order_id: c.order_id, url, ref, error, phone_number_id: c.phone_number_id, access_token: c.access_token,\n  graph_version: c.graph_version, to: c.to, service: c.service.name, name: c.customer.name, number: c.number } };",
    "mode": "runOnceForEachItem"
   },
   "id": "8d368cad-4a96-5800-b9b7-8b2b336334d7",
   "name": "Resultado de la pasarela",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    960,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "64e7dbf7-79ea-5c8b-8c48-811c6d617a7c",
       "leftValue": "={{ !!$json.url }}",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },

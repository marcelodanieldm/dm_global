   "id": "0fb58c2d-e91a-537e-b086-422977e021d4",
   "name": "Guardar link",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1400,
    -80
   ],
   "credentials": {
    "postgres": {
     "id": "pgChatbotCred01",
     "name": "Postgres chatbot"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const j = $('Resultado pasarela').item.json;\nreturn { json: { phone_number_id: j.phone_number_id, access_token: j.access_token, graph_version: j.graph_version, to: j.to,\n  message: { type: 'interactive', interactive: { type: 'cta_url',\n    body: { text: 'Listo, ' + j.name + '. Este es tu link para pagar el plan ' + j.plan + '. Cuando se acredite el pago te aviso por acá.' },\n    action: { name: 'cta_url', parameters: { display_text: 'Pagar ahora', url: j.url } } } } } };",
    "mode": "runOnceForEachItem"
   },
   "id": "58113df3-c432-5be6-8164-1af8c2b07843",
   "name": "Mensaje con link",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1620,
    -80
   ]
  },
  {
   "parameters": {
    "jsCode": "const j = $json;\nreturn { json: { phone_number_id: j.phone_number_id, access_token: j.access_token, graph_version: j.graph_version, to: j.to,\n  message: { type: 'text', text: 'Perdón, no pude generar el link de pago en este momento. Un asesor te va a escribir para completar el alta.' },\n  error: j.error } };",
    "mode": "runOnceForEachItem"
   },
   "id": "f5049779-92bf-59c8-9b55-0ea96bc10fe1",
   "name": "Mensaje de error",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1400,
    100

   "id": "596816e9-2b84-542c-8f05-dce07b18116e",
   "name": "Según pasarela",
   "type": "n8n-nodes-base.switch",
   "typeVersion": 3.2,
   "position": [
    440,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.mercadopago.com/preapproval",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $json.c.provider_token }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({\n  reason: $json.c.plan.name + ' · ' + $json.c.tenant_name,\n  external_reference: $json.c.subscription_id,\n  payer_email: $json.c.customer.email,\n  back_url: $json.c.provider_config.back_url || 'https://dmglobal.tech',\n  status: 'pending',\n  auto_recurring: {\n    frequency: $json.c.plan.interval === 'year' ? 12 : 1, frequency_type: 'months',\n    transaction_amount: Number($json.c.plan.price), currency_id: $json.c.plan.currency\n  }\n}) }}",
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     },
     "timeout": 20000
    }
   },
   "id": "aa8be72c-b5ce-5344-ab43-ccddc8a8df7d",
   "name": "Mercado Pago: crear preapproval",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    700,
    -180
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.stripe.com/v1/checkout/sessions",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $json.c.provider_token }}"
      }
     ]
    },
    "sendBody": true,
    "contentType": "form-urlencoded",
    "bodyParameters": {
     "parameters": [
      {
       "name": "mode",
       "value": "subscription"
      },
      {
       "name": "line_items[0][price]",
       "value": "={{ $json.c.plan.provider_price_id }}"
      },
      {
       "name": "line_items[0][quantity]",
       "value": "1"
      },
      {
       "name": "client_reference_id",
       "value": "={{ $json.c.subscription_id }}"
      },
      {
       "name": "customer_email",
       "value": "={{ $json.c.customer.email }}"
      },
      {
       "name": "metadata[tenant_id]",
       "value": "={{ $json.c.tenant_id }}"
      },
      {
       "name": "subscription_data[metadata][subscription_id]",
       "value": "={{ $json.c.subscription_id }}"
      },
      {
       "name": "success_url",
       "value": "={{ $json.c.provider_config.success_url || 'https://dmglobal.tech' }}"
      },
      {
       "name": "cancel_url",
       "value": "={{ $json.c.provider_config.back_url || 'https://dmglobal.tech' }}"
      }
     ]
    },
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     },
     "timeout": 20000
    }
   },
   "id": "d090dd7c-a118-53a8-a773-28dc6431c4ee",
   "name": "Stripe: crear checkout session",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    700,
    -40
   ]
  },
  {
   "parameters": {
    "jsCode": "// Pasarela simulada: el link activa la suscripción al abrirlo (solo para tenants con provider = mock)\nconst c = $json.c;\nreturn { json: { url: 'https://n8n.dmglobal.tech/webhook/pagos-mock?tenant=' + c.tenant_id + '&ref=' + c.subscription_id, ref: 'mock-' + c.subscription_id } };",
    "mode": "runOnceForEachItem"
   },
   "id": "0ff25895-0dca-5009-9e31-51d68ae66884",
   "name": "Simulada: armar link",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    700,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "return { json: { error: 'El cliente no tiene pasarela de pago configurada (payment_integrations)' } };",
    "mode": "runOnceForEachItem"
   },
   "id": "80855c2a-cb43-573e-b7e1-a8d5f8a128e3",
   "name": "Sin pasarela",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    700,
    240
   ]
  },
  {
   "parameters": {
    "jsCode": "// Normaliza la respuesta de la pasarela: {url, ref} o {error}\nconst c = $('Datos del checkout').item.json.c;\nconst j = $json; let url = null, ref = null, error = j.error || null;\nif (!error && j.statusCode !== undefined) {\n  const b = j.body || {};\n  if (j.statusCode >= 200 && j.statusCode < 300) { url = b.init_point || b.url; ref = b.id; }\n  else error = 'HTTP ' + j.statusCode + ': ' + JSON.stringify(b.message || b.error || b).slice(0, 300);\n} else if (!error) { url = j.url; ref = j.ref; }\nif (!url && !error) error = 'La pasarela no devolvió un link de pago';\nreturn { json: { subscription_id: c.subscription_id, url, ref, error, provider: c.provider,\n  phone_number_id: c.phone_number_id, access_token: c.access_token, graph_version: c.graph_version, to: c.to,\n  plan: c.plan.name, name: c.customer.name } };",
    "mode": "runOnceForEachItem"
   },
   "id": "821da17f-451a-56a5-acf6-179e9a9726f6",
   "name": "Resultado pasarela",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    960,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "64e7dbf7-79ea-5c8b-8c48-811c6d617a7c",
       "leftValue": "={{ !!$json.url }}",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "ff15f079-f475-5ae4-988f-6d1b0355f212",
   "name": "¿Hay link?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    1180,
    0
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT bot_rf04_checkout_created($1::uuid, $2, $3) AS r;",

   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT bot_rf11_upsert_order($1::uuid, $2::jsonb) AS id WHERE $2 <> 'null';",
    "options": {
     "queryReplacement": "={{ [ $json.tenant_id, JSON.stringify($json.order) ] }}"
    }

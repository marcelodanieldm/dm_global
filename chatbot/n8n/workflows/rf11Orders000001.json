  {
   "parameters": {
    "jsCode": "// Tiendanube manda solo {store_id, event, id}: hay que pedir el pedido a su API. Otro sistema manda el pedido completo.\nconst b = $json.body || {};\nconst tn = !!(b.store_id && b.event && b.id && /^order\\//.test(b.event));\nreturn { json: { key: ($json.query && $json.query.key) || '', tiendanube: tn, order_id: tn ? String(b.id) : '', body: b } };",
    "mode": "runOnceForEachItem"
   },

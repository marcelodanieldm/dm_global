   "position": [
    1120,
    -160
   ]
  },
  {
   "parameters": {
    "jsCode": "// Pedido de Tiendanube → formato normalizado\nconst o = $json.body || {}, src = $('Leer aviso').item.json, ctx = $('Datos de la tienda').item.json.c;\nif ($json.statusCode !== 200) return { json: { tenant_id: ctx.tenant_id, order: null, error: 'HTTP ' + $json.statusCode } };\nconst name = v => (v && typeof v === 'object') ? (v.es || Object.values(v)[0] || '') : (v || '');\nreturn { json: { tenant_id: ctx.tenant_id, error: null, order: {\n  source: 'tiendanube', external_id: String(o.id), number: String(o.number || o.id),\n  name: o.contact_name || (o.customer && o.customer.name) || '', email: o.contact_email || (o.customer && o.customer.email) || '',\n  phone: o.contact_phone || (o.customer && o.customer.phone) || '', tax_id: o.contact_identification || (o.customer && o.customer.identification) || '',\n  status: o.status, payment_status: o.payment_status, shipping_status: o.shipping_status,\n  tracking_number: o.shipping_tracking_number || '', tracking_url: o.shipping_tracking_url || '',\n  total: o.total, currency: o.currency || 'ARS', created_at: o.created_at,\n  items: (o.products || []).map(p => ({ name: name(p.name), quantity: Number(p.quantity || 1), price: Number(p.price || 0) })) } } };",
    "mode": "runOnceForEachItem"
   },
   "id": "ef5c2353-fee5-5d61-91bb-956ad1a9f2b5",
   "name": "Normalizar pedido",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1340,

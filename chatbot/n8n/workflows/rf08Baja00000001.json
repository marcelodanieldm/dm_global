  {
   "parameters": {
    "jsCode": "// Resultado de detener los cobros en la pasarela\nconst r = $('Confirmar baja').item.json.r;\nconst j = $json; let ok = true, detail = '';\nif (j.statusCode !== undefined) { ok = j.statusCode >= 200 && j.statusCode < 300; detail = ok ? '' : 'HTTP ' + j.statusCode + ': ' + JSON.stringify(j.body).slice(0, 300); }\nreturn { json: { subscription_id: r.subscription_id || '', ok, detail, cancelled_now: !!(r.ok && !r.already), tenant_id: r.tenant_id || '',\n                 notify_text: r.notify_text || '' } };",
    "mode": "runOnceForEachItem"
   },

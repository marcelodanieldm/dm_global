      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "77e312d6-9fd9-5ea0-9354-ebf55a9b660f",
       "leftValue": "={{ $json.relevant }}",
       "operator": {
        "type": "boolean",

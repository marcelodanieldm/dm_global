    "query": "SELECT bot_rf04_activate(pi.tenant_id, 'mock', 'mock-' || $2, $2::uuid, 'mock-' || $2, NULL, '{}') AS r\nFROM payment_integrations pi WHERE pi.tenant_id = $1::uuid AND pi.provider = 'mock' AND pi.is_active;",

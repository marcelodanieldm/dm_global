  {
   "parameters": {
    "jsCode": "// Solo una suscripción autorizada activa el alta\nconst b = $json.body || {}, src = $('MP: leer aviso').item.json;\nconst ok = $json.statusCode === 200 && b.status === 'authorized' && !!b.external_reference;\nreturn { json: { ok, tenant_id: src.tenant_id, provider: 'mercadopago', event_id: 'mp-' + b.id + '-' + b.status,\n  subscription_id: b.external_reference || '', ref: b.id || '', period_end: b.next_payment_date || '', payload: b } };",
    "mode": "runOnceForEachItem"
   },

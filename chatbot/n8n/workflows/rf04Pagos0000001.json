  {
   "parameters": {
    "jsCode": "// Evento de Stripe: solo checkout.session.completed. No se confía en el cuerpo: se vuelve a leer la sesión con la API\nconst q = $json.query || {}, b = $json.body || {};\nconst obj = (b.data && b.data.object) || {};\nreturn { json: { tenant_id: q.tenant || '', type: b.type || '', id: obj.id || '',\n  relevant: b.type === 'checkout.session.completed' && !!obj.id && !!q.tenant } };",
    "mode": "runOnceForEachItem"
   },

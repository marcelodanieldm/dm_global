  {
   "parameters": {
    "jsCode": "const b = $json.body || {}, src = $('Stripe: leer evento').item.json;\nconst ok = $json.statusCode === 200 && b.status === 'complete' && ['paid', 'no_payment_required'].includes(b.payment_status) && !!b.client_reference_id;\nreturn { json: { ok, tenant_id: src.tenant_id, provider: 'stripe', event_id: 'st-' + b.id,\n  subscription_id: b.client_reference_id || '', ref: b.subscription || b.id || '', period_end: '', payload: { id: b.id, subscription: b.subscription } } };",

  {
   "parameters": {
    "jsCode": "// Notificación de Mercado Pago: solo interesan las de suscripción (preapproval)\nconst q = $json.query || {}, b = $json.body || {};\nconst type = b.type || b.topic || q.type || q.topic || '';\nconst id = (b.data && b.data.id) || q['data.id'] || q.id || '';\nreturn { json: { tenant_id: q.tenant || '', type, id: String(id), relevant: /preapproval/.test(type) && !!id && !!q.tenant } };",
    "mode": "runOnceForEachItem"
   },
   "id": "1f84d137-c3ab-5bc3-992e-2b27c8bc0033",
   "name": "MP: leer aviso",
